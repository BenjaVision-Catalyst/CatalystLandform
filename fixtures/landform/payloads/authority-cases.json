          "expect": "TEMPORAL_STALE"
        }
      ]
    },
    {
      "name": "retry-does-not-apply-twice",
      "actions": [
        {
          "submit": "sampled-remove",
          "expect": "accepted",
          "counter": 1
        },
        {
          "submit": "procedural-fill",
          "expect": "accepted",
          "counter": 2
        },
        {
          "submit": "sampled-remove",
          "expect": "accepted",
          "counter": 1
        }
      ]
    },
    {
      "name": "same-id-different-command",
      "actions": [
        {
          "submit": "sampled-remove",
          "expect": "accepted",
          "counter": 1
        },
        {
          "submit": "reused-id",
          "expect": "IDEMPOTENCY_MISMATCH"
        }
      ]
    },
